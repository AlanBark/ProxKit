{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ProxKit",
  "version": "0.1.0",
  "identifier": "io.github.alanbark.proxkit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ProxKit",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AlanBark/proxy-print-and-cut/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOUJGNTRBNkFENEVBNzkKUldSNTZ0UnFTdldiWVBNcVRPQXI0VmNwVC8rbVpBOFJFai9Gdk0xVzZra1IzRytTWXFJZklIMFMK"
    }
  }
}
